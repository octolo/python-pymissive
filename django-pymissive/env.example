# =============================================================================
# Django Missive - Environment variables
# =============================================================================
# Copy this file to .env and fill in your API keys

# Django
SECRET_KEY=your-secret-key-here
DEBUG=True

# Brevo
BREVO_EMAIL_API_KEY=
BREVO_SMS_API_KEY=
BREVO_WHATSAPP_API_KEY=
BREVO_WEBHOOK_SECRET=

# Scaleway
SCALEWAY_ACCESS_KEY=
SCALEWAY_SECRET_ACCESS_KEY=
SCALEWAY_REGION=fr-par
SCALEWAY_PROJECT_ID=
SCALEWAY_WEBHOOK_SECRET=

# SMSPartner
PARTNER_SMS_API_KEY=
PARTNER_SENDER_NAME=Missive

# Maileva
MAILEVA_CLIENTID=
MAILEVA_SECRET=
MAILEVA_USERNAME=
MAILEVA_PASSWORD=
MAILEVA_SANDBOX=False
MAILEVA_WEBHOOK_SECRET=
MAILEVA_WEBHOOK_BASIC_LOGIN=pymissive

# Team messaging
SLACK_BOT_TOKEN=
SLACK_CHANNEL_ID=
TEAMS_WEBHOOK_URL=
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=

# Hand delivery
HAND_DELIVERY_DELIVERER_NAME=

# =============================================================================
# Default Email configuration (Django)
# =============================================================================

EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@example.com

# =============================================================================
# Local campaign testing (tests/settings.py, read by manage.py only)
# =============================================================================

# Fallback provider for missives with none set (e.g. fake)
PYMISSIVE_DEFAULT_PROVIDER=
# Seconds each send of the fake provider blocks, to cancel a run by hand
FAKE_SLEEP_SECONDS=0
# Dotted path called at each progress step of a campaign send
PYMISSIVE_PROGRESS_HOOK=

# =============================================================================
# Ngrok (Development tunnel)
# =============================================================================

# Ngrok authentication token (optional but recommended)
# Get your token from https://dashboard.ngrok.com/get-started/your-authtoken
NGROK_TOKEN=
